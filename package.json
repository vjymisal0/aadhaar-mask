{
  "name": "@vjymisal0/aadhaar-mask",
  "version": "1.1.0",
  "description": "Zero-dependency, regulation-compliant Indian Aadhaar number validator, Verhoeff checksum verifier, and 8-digit secure masker (XXXX XXXX 1234) for UIDAI and RBI compliance.",
  "author": "Vijay Misal <misalvijay153@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vjymisal0/aadhaar-mask.git"
  },
  "bugs": {
    "url": "https://github.com/vjymisal0/aadhaar-mask/issues"
  },
  "homepage": "https://github.com/vjymisal0/aadhaar-mask#readme",
  "keywords": [
    "aadhaar",
    "aadhaar-mask",
    "aadhaar-masking",
    "uidai",
    "uidai-compliance",
    "verhoeff",
    "verhoeff-algorithm",
    "kyc",
    "india-compliance",
    "rbi-compliance",
    "fintech-india",
    "aadhaar-validator",
    "masking",
    "checksum"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3",
    "@types/node": "^26.6.4"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
